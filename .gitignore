# inventories/**/hosts.ini
# inventories/**/hosts.yml

# --- OS / Editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Python (si usas scripts) ---
__pycache__/
*.pyc
.venv/
venv/

# --- CI / Jenkins ---
workspaces/